            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/requests",
            "description": "Создаёт новую демонстрационную запись. При конфликте ИСУ выполнение останавливается: существующие записи не изменяются.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isu\": {{studentIsu}},\n  \"fio\": \"Иванов Иван Иванович\",\n  \"group\": \"M3301\",\n  \"dorm\": 1,\n  \"room\": 101,\n  \"date\": \"2026-09-01\",\n  \"isForeigner\": false,\n  \"notes\": \"Коллекция {{runId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.environment.set('createdStudentIsu', pm.response.json().isu);",
                  "else pm.execution.setNextRequest(null);",
                  "pm.test(\"ИСУ и Location\", () => { pm.expect(pm.response.json().isu).to.eql(Number(pm.environment.get('studentIsu'))); pm.expect(pm.response.headers.get('Location')).to.include('/api/requests/'); });"
                ]
              }
            }
          ]
        },

                  "pm.test(\"Страница демонстрационного студента\", () => { const page = pm.response.json(); pm.expect(page.data).to.have.lengthOf(1); pm.expect(page.data[0].isu).to.eql(Number(pm.environment.get('createdStudentIsu'))); pm.expect(page.pagination).to.include({page:1,limit:1,total:1,total_pages:1,has_next:false,has_prev:false}); });"
                ]
              }
            }
          ]
        },

              "raw": "{\n  \"page\": 1,\n  \"limit\": 20,\n  \"search\": \"{{runId}}\",\n  \"group\": \"M3301\",\n  \"dorm\": 1,\n  \"room\": 101,\n  \"isForeigner\": false,\n  \"sort\": \"fio,asc\"\n}",

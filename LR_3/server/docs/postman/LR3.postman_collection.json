{
  "info": {
    "name": "ЛР 3 — студенты, JWT и роли",
    "_postman_id": "1ed7144d-d93c-4992-84bf-5613f9255685",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Импортируйте окружение local.postman_environment.example.json, задайте адрес и существующего ADMIN. Запускайте папки по порядку на демонстрационной БД. Коллекция создаёт новый USER и одного студента; студент удаляется в конце, аккаунт USER остаётся. Токены сохраняются автоматически и очищаются последним запросом. QUERY — настоящий нестандартный HTTP-метод."
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) pm.test('Единый формат ошибки', () => pm.expect(pm.response.json().error).to.be.a('string'));"
        ]
      }
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "1. Подготовка и пользователи",
      "item": [
        {
          "name": "01. Состояние сервера и подготовка демонстрации",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Ожидаемый результат: HTTP 200."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now() + '_' + pm.variables.replaceIn('{{$guid}}').slice(0,8);",
                  "pm.environment.set('runId', runId);",
                  "pm.environment.set('demoUsername', 'lab3_demo_' + runId);",
                  "pm.environment.set('demoEmail', 'lab3_demo_' + runId + '@example.org');",
                  "pm.environment.set('demoPassword', pm.variables.replaceIn('{{$guid}}') + 'Aa1!');",
                  "const isu = Math.floor(100000 + Math.random() * 799998);",
                  "pm.environment.set('studentIsu', isu);",
                  "pm.environment.set('updatedIsu', isu + 1);",
                  "['createdStudentIsu','adminAccessToken','adminRefreshToken','userAccessToken','userRefreshToken','previousUserRefreshToken'].forEach(key => pm.environment.set(key, ''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"Приложение готово\", () => { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Вход ADMIN",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Ожидаемый результат: HTTP 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('adminUsername') || !pm.environment.get('adminPassword')) {",
                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error('Выберите окружение и задайте adminUsername/adminPassword существующего ADMIN.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const pair = pm.response.json();",
                  "  pm.environment.set('adminAccessToken', pair.accessToken);",
                  "  pm.environment.set('adminRefreshToken', pair.refreshToken);",
                  "}",
                  "pm.test(\"Пара токенов и no-store\", () => { pm.expect(pm.response.json()).to.include.keys('accessToken','refreshToken','user'); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });",
                  "pm.test(\"Роль ADMIN\", () => { pm.expect(pm.response.json().user.role).to.eql('ADMIN'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03. Регистрация — роль ADMIN из тела игнорируется",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Ожидаемый результат: HTTP 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{demoUsername}}\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test(\"Создан USER без пароля и хеша в ответе\", () => { const user = pm.response.json(); pm.expect(user.role).to.eql('USER'); pm.expect(user).not.to.have.property('password'); pm.expect(user).not.to.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04. Вход USER",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Ожидаемый результат: HTTP 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{demoUsername}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const pair = pm.response.json();",
                  "  pm.environment.set('userAccessToken', pair.accessToken);",
                  "  pm.environment.set('userRefreshToken', pair.refreshToken);",
                  "}",
                  "pm.test(\"Пара токенов и no-store\", () => { pm.expect(pm.response.json()).to.include.keys('accessToken','refreshToken','user'); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05. Текущий пользователь USER",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Ожидаемый результат: HTTP 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"Роль USER\", () => { pm.expect(pm.response.json().role).to.eql('USER'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Студенты и права",
      "item": [
        {

# For Docker Compose: copy this file to .env and replace the password.
# For Spring Boot: set these as environment variables in the terminal or IDE.
# Spring Boot does not read .env automatically.
# start.cmd generates and loads a private .env automatically; do not copy this
# example over an existing local configuration.
COMPOSE_PROJECT_NAME=itmo-lr3
JAVA_HOME=
DB_NAME=students
DB_USER=students
DB_PASSWORD=replace-with-your-local-password
DB_PORT=55432
DB_URL=jdbc:postgresql://127.0.0.1:55432/students
SERVER_PORT=8080
FRONTEND_PORT=5500
JPA_LOG_LEVEL=WARNING
APP_LOG_LEVEL=INFO
RATE_LIMIT_MAX_REQUESTS=100
# Base64 of at least 32 cryptographically random bytes; no production default.
JWT_SECRET=replace-with-a-generated-base64-secret
JWT_ISSUER=students-server
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Optional first ADMIN, disabled by default. Existing accounts are never promoted/reset.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Internal one-time import; normally controlled by the launcher, not set manually.
IMPORT_STUDENTS_ENABLED=false
IMPORT_STUDENTS_PATH=
IMPORT_STUDENTS_REPORT=
